{
  "manifest_version": 3,
  "name": "Keybar",
  "description": "A fast, keyboard-first command bar for Chrome.",
  "icons": {
    "16": "icons/keybar-16.png",
    "48": "icons/keybar-48.png",
    "128": "icons/keybar-128.png"
  },
  "minimum_chrome_version": "127",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "optional_permissions": ["bookmarks", "history", "tabGroups", "sessions", "clipboardWrite"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Keybar",
    "default_icon": {
      "16": "icons/keybar-16.png",
      "48": "icons/keybar-48.png"
    }
  },
  "commands": {
    "open-command-palette": {
      "suggested_key": {
        "windows": "Ctrl+T",
        "linux": "Ctrl+T",
        "mac": "Command+T"
      },
      "description": "Open Keybar"
    },
    "open-tab-switcher": {
      "suggested_key": {
        "windows": "Ctrl+A",
        "linux": "Ctrl+A",
        "mac": "MacCtrl+A"
      },
      "description": "Open the tab switcher"
    }
  }
}
